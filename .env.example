NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AWS_REGION=ap-south-1
AWS_KMS_KEY_ID=
AWS_OUTBOX_QUEUE_URL=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Customers connect their own Plivo account after login; no shared Plivo credentials.
# AWS_KMS_KEY_ID encrypts workspace connection tokens in the web control plane.
# The voice service needs kms:Decrypt for that key with provider=plivo context.
SARVAM_API_KEY=
CARTESIA_API_KEY=
# HTTPS origin only. Route an AWS ALB to the persistent voice container.
VOICE_PUBLIC_URL=
VOICE_PORT=8080
VOICE_SERVICE_MAX_SESSIONS=20
CARTESIA_VOICE_EN=
CARTESIA_VOICE_HI=
# Enable only after per-workspace acceptance evidence is recorded.
VOICE_CALLING_ENABLED=false
LIVE_SENDING_ENABLED=false
PAID_CHECKOUT_ENABLED=false
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com
