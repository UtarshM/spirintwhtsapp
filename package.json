{
  "name": "relay-scalezix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "worker:meta-events": "node --env-file=.env.local --import tsx services/worker/run-meta-events.ts",
    "voice:start": "node --env-file-if-exists=.env.local --import tsx services/voice/run.ts",
    "voice:reconcile": "node --env-file-if-exists=.env.local --import tsx services/voice/reconcile.ts",
    "voice:analyze": "node --env-file-if-exists=.env.local --import tsx services/voice/analysis.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.900.0",
    "@aws-sdk/client-sqs": "^3.900.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.80.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "plivo": "4.75.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
